# ─────────────────────────────────────────────────────────────────────────────
# IBM Granite / watsonx.ai (REQUIRED for AI briefs)
# Get credentials at: https://cloud.ibm.com → watsonx.ai → Project settings
# ─────────────────────────────────────────────────────────────────────────────
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL=ibm/granite-13b-instruct-v2

# ─────────────────────────────────────────────────────────────────────────────
# NASA FIRMS — Active fire hotspots (free signup)
# Register at: https://firms.modaps.eosdis.nasa.gov/api/area/
# ─────────────────────────────────────────────────────────────────────────────
FIRMS_MAP_KEY=your_firms_map_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Local storage paths (defaults work out of the box)
# ─────────────────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
DB_PATH=./satellite_insights.db
